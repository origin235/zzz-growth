.skill-head {
  margin: 22rpx 0 6rpx;
  font-size: 22rpx;
  color: #7b818d;
  letter-spacing: 1rpx;
}
.param-input {
  width: 180rpx;
  height: 60rpx;
  text-align: right;
  font-size: 26rpx;
  color: #d9ff3f;
  background: #1b1e26;
  border: 2rpx solid #2e333d;
  border-radius: 6rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.mrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #1c1f26;
}
.mrow:last-child {
  border-bottom: none;
}
.mrow-l {
  flex: 1;
  min-width: 0;
}
.mrow-name {
  font-size: 26rpx;
  color: #e0e4ea;
}
.mrow-note {
  font-size: 20rpx;
  color: #6f7480;
  margin-top: 4rpx;
}
.mrow-r {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.mrow-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #f0f2f5;
  font-variant-numeric: tabular-nums;
}
.mrow-energy {
  font-size: 22rpx;
  color: #d9ff3f;
  margin-top: 4rpx;
}
.mrow-energy.zero {
  color: #5d636e;
}
.foot {
  margin: 28rpx 8rpx 10rpx;
  font-size: 20rpx;
  color: #5d636e;
  line-height: 1.7;
}
