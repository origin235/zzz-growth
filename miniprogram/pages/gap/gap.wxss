.pb {
  padding-bottom: 40rpx;
}
.hint-warn {
  border-left-color: #ff6b35;
  color: #ff9d6b;
}
/* 材料卡 */
.gcard {
  background: #12141a;
  border: 2rpx solid #262a33;
  border-radius: 10rpx;
  padding: 22rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
}
.ghead {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.gname {
  font-size: 27rpx;
  font-weight: 600;
  color: #f0f2f5;
}
.gflag {
  font-size: 22rpx;
  color: #d9ff3f;
  background: rgba(217, 255, 63, 0.09);
  border-radius: 4rpx;
  padding: 4rpx 12rpx;
}
.gflag-done {
  color: #8b909c;
  background: rgba(255, 255, 255, 0.05);
}
.stat-grid.cols3 .stat {
  width: 33.333%;
}

.gbyte {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0 4rpx;
}
.gb-k {
  font-size: 21rpx;
  color: #8b909c;
  margin-right: 22rpx;
}
.gb-e {
  color: #d9ff3f;
}
.ghold {
  display: flex;
  margin: 10rpx -8rpx 0;
}
.hitem {
  flex: 1;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.hlabel {
  display: block;
  font-size: 20rpx;
  color: #6f7480;
  margin-bottom: 6rpx;
}
.hinput {
  width: 100%;
  height: 66rpx;
  font-size: 26rpx;
  color: #e9ecf1;
  text-align: center;
  background: #1b1e26;
  border: 2rpx solid #2e333d;
  border-radius: 6rpx;
  box-sizing: border-box;
}
.ghold-one {
  align-items: flex-end;
}
.hinput-one {
  text-align: left;
  padding: 0 20rpx;
  height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.hitem-flag {
  flex: 0 0 190rpx;
}
.hgap {
  display: block;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #d9ff3f;
  font-variant-numeric: tabular-nums;
}
.gnote {
  font-size: 20rpx;
  color: #6f7480;
  margin-top: 12rpx;
  line-height: 1.5;
}
.foot {
  margin: 20rpx 8rpx 10rpx;
  font-size: 20rpx;
  color: #5d636e;
  line-height: 1.7;
}
